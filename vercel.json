{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "echo 'No dependencies to install'",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    { "source": "/(.*)\\.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/(styles\\.css|app\\.js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
